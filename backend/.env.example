# Sao chép file này thành .env và điền giá trị thật - KHÔNG commit .env lên Git.

# Connection string Postgres (Neon). Lấy từ Neon dashboard > Connection Details.
# Neon cấp 2 dạng URL: "pooled" (khuyên dùng cho DATABASE_URL ở runtime/production)
# và "direct/unpooled" (dùng khi `prisma migrate dev` gặp lỗi shadow database qua pooler).
DATABASE_URL="postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require"

# Cổng HTTP server - Render tự set PORT, giá trị dưới đây chỉ dùng khi chạy local.
PORT=3000

# Origin duy nhất được phép gọi API qua CORS - domain frontend thật trên Vercel.
FRONTEND_ORIGIN="https://your-frontend.vercel.app"

# Auth - JWT + bcrypt. JWT_SECRET production PHẢI là chuỗi ngẫu nhiên mạnh,
# set trực tiếp trong Render dashboard, không đưa giá trị thật vào file này.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1h"
BCRYPT_SALT_ROUNDS="10"
